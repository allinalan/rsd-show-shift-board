<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.allinalan.rsd-board-tick</string>
    <!--
      Template: install.sh replaces __PROJECT__ and writes this to ~/Library/LaunchAgents.
      Rooted in /usr/bin/python3 because that is the only identity on the mini allowed to
      control Messages.app (the tick sends Alan one iMessage when a routine is due).
      Kill switch: a PAUSED file in the project root, or ./install.sh (with no flag) to disarm.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__PROJECT__/deploy/tick.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT__</string>
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
    <key>StandardOutPath</key>
    <string>__PROJECT__/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT__/logs/launchd.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
